# Where Are U · Web (Vue 3 + Vite)
# Copy to `.env` (or `.env.local`) and adjust as needed.

# ---------------------------------------------------------------------------
# Mock API. OFF by default, and production builds refuse VITE_USE_MOCK=true.
# For a local seeded demo use:
#   VITE_USE_MOCK=true npm run dev
# The mock module is loaded dynamically and is excluded from clean builds.
# ---------------------------------------------------------------------------
VITE_USE_MOCK=false

# Dev-only proxy target. When set, the browser talks to the same-origin "/api"
# path and Vite forwards it to this server, which sidesteps CORS entirely.
# Example against a deployed host:
#   VITE_API_BASE_URL=/api
#   VITE_DEV_API_TARGET=http://182.254.155.179:18080
VITE_DEV_API_TARGET=

# API base URL (must include /api). Used when VITE_USE_MOCK=false.
# Local development accepts any http(s) host, including a public IP or domain
# (e.g. http://203.0.113.7:3000/api). Production builds require HTTPS or a
# same-origin path.
# Production deployments should serve the web app and API from the same
# origin (e.g. /api) or use HTTPS.
VITE_API_BASE_URL=http://localhost:3000/api

# ---------------------------------------------------------------------------
# AMap JS API 2.0 (optional).
# Leave BOTH blank to use the built-in schematic map (fully offline).
# Never commit real keys.
# ---------------------------------------------------------------------------
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
