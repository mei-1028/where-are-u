# Server
PORT=3000

# Prisma SQLite connection string. Relative paths resolve next to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# HS256 signing secret for user JWTs (7 days). REQUIRED: at least 32 random bytes.
# Generate (Node): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Generate (bash): openssl rand -base64 48
JWT_SECRET=""

# Comma separated list of allowed origins, or "*" for any origin.
# Local development: "*" works for any dev port / LAN IP / public host.
# Production: list the exact web origins, e.g. "https://home.example.com".
CORS_ORIGIN="*"

# How long an "locate now" command may stay pending before it is marked timeout.
LOCATE_TIMEOUT_MS=30000

# Trust X-Forwarded-For from these proxies: false | true | hop count | proxy-addr list.
# Behind Caddy/nginx in Docker use "loopback,uniquelocal"; keep false when directly exposed.
TRUST_PROXY="false"

# Optional: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
