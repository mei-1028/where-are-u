# frpc.toml —— 运行在家中设备，主动连接 VPS 上的 frps
# 复制为 deploy/frpc.toml 后填写真实值；真实文件已被 .gitignore 忽略。
# 拓扑：VPS:80/443 --TCP 透传--> 家中 Caddy:80/443（TLS 在 Caddy 终结）

serverAddr = "203.0.113.10"        # TODO: VPS 公网 IP（203.0.113.10 为文档保留地址）
serverPort = 7000
loginFailExit = false              # VPS 暂不可达时持续重试，适合家庭网络

auth.method = "token"
auth.token = "REPLACE_WITH_FRP_TOKEN"

# 80：用于 Caddy 的 ACME HTTP-01 校验与 HTTP -> HTTPS 跳转
[[proxies]]
name = "where-are-u-http"
type = "tcp"
localIP = "127.0.0.1"
localPort = 80
remotePort = 80

# 443：原样透传 TLS，客户端到家中 Caddy 之间端到端加密
[[proxies]]
name = "where-are-u-https"
type = "tcp"
localIP = "127.0.0.1"
localPort = 443
remotePort = 443

# 说明：
# - 若 frpc 与 Caddy 不在同一台机器/同一网络命名空间，localIP 需改为可达地址。
# - 保持控制通道 TLS（frp 默认启用）；token 必须与 frps.toml 一致。
# - VPS 的 80/443/7000 需在安全组与系统防火墙放行。
