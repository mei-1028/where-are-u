# 复制为 deploy/.env 后填写；真实 .env 已被 .gitignore 忽略，切勿提交。
# 变量用途与生成方式见 ../docs/setup.md

# 公网域名。frp 模式填写裸域名；Cloudflare Tunnel 模式改为 :80
SITE_DOMAIN=where-are-u.example.com

# 必填：服务端 JWT 签名密钥，至少 32 字节随机值（建议 openssl rand -hex 32）。
# 留空时 docker compose 会拒绝启动，避免误用固定弱密钥。
JWT_SECRET=

# 允许的浏览器来源（逗号分隔）。生产与 Web 同源，保底填公网 https 来源；
# 不要留空（server 要求非空字符串）
CORS_ORIGIN=https://where-are-u.example.com

# Web 构建产物目录（相对 deploy/）；也可设为 ../web/dist
WEB_DIST_DIR=./web-dist

# 日志级别（fatal/error/warn/info/debug/trace/silent）
LOG_LEVEL=info
